{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ is an input device. Disconnecting it can make the keyboard or trackpad stop working until it reconnects.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是输入设备。断开连接可能导致键盘或触控板在重新连接前无法使用。"
          }
        }
      }
    },
    "%@ managed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已管理 %@"
          }
        }
      }
    },
    "%lld managed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已管理 %lld"
          }
        }
      }
    },
