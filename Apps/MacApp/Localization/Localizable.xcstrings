    "A small menu bar app that connects and disconnects the Bluetooth device you choose when your display wakes and sleeps." : {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款小巧的菜单栏应用：当显示屏唤醒或休眠时，连接或断开你选择的蓝牙设备。"
          }
        }
      }
    },
