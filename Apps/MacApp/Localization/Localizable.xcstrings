    "BlueLink": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BlueLink"
          }
        }
      }
    },
    "BlueLink Author": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BlueLink 作者"
          }
        }
      }
    },
    "BlueLink asks for Bluetooth access the first time it reads your paired devices. It never powers Bluetooth on, never pairs or unpairs devices, and never manages a device you have not selected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BlueLink 首次读取已配对设备时会请求蓝牙访问权限。它绝不会开启蓝牙、配对或取消配对设备，也不会管理你未选择的设备。"
          }
        }
      }
    },
    "BlueLink stops managing %@. Its current connection is left unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BlueLink 将不再管理 %@，当前的连接状态保持不变。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "Checks GitHub Releases. Nothing is downloaded or installed automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 GitHub Releases。不会自动下载或安装任何内容。"
          }
        }
      }
    },
    "Choose a paired Bluetooth device. BlueLink connects and disconnects it with your display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已配对的蓝牙设备。BlueLink 会随显示屏状态连接或断开它。"
          }
        }
      }
    },
