      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 %@"
          }
        }
      }
    },
    "Connect and disconnect the devices below with the display and system sleep. Turning this off never disconnects a device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据显示屏和系统睡眠状态连接或断开下方设备。关闭此选项绝不会断开任何设备。"
          }
        }
      }
    },
